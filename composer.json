{
  "name": "wexample/symfony-accounting-fr",
  "description": "French law for symfony-accounting: PCG and association charts, FEC export and import, VAT returns (CA3, CA12), corporate tax, legal mentions, SIREN/SIRET, French bank formats",
  "type": "library",
  "license": "MIT",
  "version": "2.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyAccountingFr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyAccountingFr\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-accounting": ">=4.0.0",
    "wexample/symfony-helpers": ">=14.0.0",
    "phpoffice/phpspreadsheet": "^2.0 || ^3.0 || ^4.0 || ^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}